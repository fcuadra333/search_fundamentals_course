{% extends "base.jinja2" %}
{% block title %}{{ t('error.generic') }}{% endblock %}
{% block content %}
  <div class="page-head"><div><h1>{{ t('error.generic') }}</h1></div></div>
  <div class="card"><div class="card-body">
    <div class="notice danger"><strong>{{ message }}</strong></div>
    {% if error and error.params %}
      <dl class="kv">
        {% for key, value in error.params.items() %}
          <dt>{{ key }}</dt><dd class="mono">{{ value }}</dd>
        {% endfor %}
      </dl>
    {% endif %}
    <p style="margin-top:14px"><a class="btn" href="{{ url_for('main.dashboard') }}">{{ t('action.back') }}</a></p>
  </div></div>
{% endblock %}
